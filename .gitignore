# ==============================================================================
# Git Ignore Rules for SCARA Simulator Project (MATLAB & Python)
# ==============================================================================

# MATLAB temporary and auto-save files
*.asv
*.m~
*.bak
*.mat.bak
*.fig.bak
*.p
*.mex*
slprj/
*.slxc

# Python byte-compiled / environment files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Operating System & Editor Files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
*.stackdump

# IDE & Editor configurations
.vscode/
.idea/
*.swp
*~

# Log files and temporary outputs
*.log
*.tmp
temp/
scratch/
